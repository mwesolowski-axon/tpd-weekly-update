    {
      "id": "8520de6e-eb3a-43ec-b497-c542e85329f2",
      "title": "Integrations/Conversions",
      "subsections": [
        {
          "id": "e0193c92-43d2-4c31-88e5-5029941b8d4a",
          "title": "Warrants",
          "bullets": [
            {
              "id": "bf9fb935-0f7b-4376-a1fb-ee6fc5c1ac2a",
              "content": "<p><strong>Integration Ticket entered for issues below</strong></p>"
            },
            {
              "id": "9c9b2efa-4eb0-4fad-bc6f-789a72966122",
              "content": "<p><strong>Issue:</strong> A warrant did not reactivate despite having the same docket number and subject. Still investigating.</p><ul><li>Certain charges coming in incorrectly.</li><li>This is partly due to the payload. The payload has the charge id and part of the charge description. It does not include the severity.</li><li>The integration picks an active charge on the MCT with the closest match to what is in the payload. Continuing to investigate.</li></ul>"
            },
            {
              "id": "86cc3ae8-3375-407d-ba6c-439393dbd9c2",
              "content": "<p><strong>Workaround:</strong> Records specialist updates warrant to correct charge</p>"
            },
            {
              "id": "f054aeaa-5ee1-44c7-ae0e-62f46f523ff2",
              "content": "<p><strong>Issue:</strong> Warrant charges duplicating on the warrant form in the UI</p><ul><li>This is due to duplicate charges within the payload</li><li>Agency has reached out to the court POC about this with examples to get the issue investigated</li></ul>"
            },
            {
              "id": "4852f60e-cd15-4779-8169-1906aec76e42",
              "content": "<p><strong>Workaround:</strong> Records team to remove the duplicate charges in the UI so they match the physical warrant</p>"
            }
          ]
        },
