# Optional local override (GitHub Actions sets VITE_BASE_PATH automatically).
# VITE_BASE_PATH=/tpd-weekly-update/

# Email drafts opened after npm run publish-week (copy to .env and customize).
EMAIL_TO=Name <email@example.com>; Another Name <other@example.com>
EMAIL_CC=Name <cc@example.com>
EMAIL_SUBJECT=Axon Weekly Update - Week of {weekOf}
SITE_URL=https://mwesolowski-axon.github.io/tpd-weekly-update
EMAIL_CLIENT=both
EMAIL_GMAIL_INBOX=0
